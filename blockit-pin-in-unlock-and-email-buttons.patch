@@ -131,11 +143,35 @@ class EmailService {
         'If your reply does not thread properly, include this tag so BlockIT '
         'can match it: $refTag';
 
+    final approveUri = _replyMailto(cfg.gmailAddress, 'APPROVE $refTag');
+    final denyUri = _replyMailto(cfg.gmailAddress, 'DENY $refTag');
+    final html = '''
+<div style="font-family: -apple-system, Roboto, Arial, sans-serif; font-size: 15px; color: #111827; line-height: 1.5;">
+  <p>${_escapeHtml(description)}</p>
