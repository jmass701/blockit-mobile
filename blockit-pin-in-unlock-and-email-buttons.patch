+  </p>
+</div>
+''';
+
     final message = Message()
       ..from = Address(cfg.gmailAddress)
       ..recipients.addAll(to)
       ..subject = kApprovalSubject
       ..text = body
+      ..html = html
       // mailer lets us pin a Message-ID via a custom header so the value we
       // store matches what the recipient's client threads against.
       ..headers['Message-ID'] = messageId;
@@ -144,6 +180,24 @@ class EmailService {
     return SentApproval(messageId);
   }
 
+  /// A mailto: URI that opens a new message addressed back to [gmailAddress]
+  /// with the approval subject and [prefilledBody] already filled in — the
+  /// "button" behind the Approve/Deny links.
+  Uri _replyMailto(String gmailAddress, String prefilledBody) => Uri(
+        scheme: 'mailto',
+        path: gmailAddress,
+        queryParameters: {
+          'subject': 'Re: $kApprovalSubject',
+          'body': prefilledBody,
+        },
+      );
+
+  String _escapeHtml(String s) => s
+      .replaceAll('&', '&amp;')
+      .replaceAll('<', '&lt;')
+      .replaceAll('>', '&gt;')
+      .replaceAll('"', '&quot;');
+
   // ---- IMAP poll ------------------------------------------------------------
 
