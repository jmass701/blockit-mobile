From 944b5a27ed4be479a4e67d2e2054fd66bd9e7884 Mon Sep 17 00:00:00 2001
From: Jared Massie <you@example.com>
Date: Thu, 13 Aug 2026 00:58:07 +0000
Subject: [PATCH] Offer in-person PIN from the unlock-request sheet; add
 Approve/Deny email buttons
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The unlock duration sheet now shows a 'Use in-person PIN instead' option
(when a PIN is configured) alongside the usual duration choices, so the
in-person PIN is reachable from the same place as a normal unlock request.

Approval emails now include HTML Approve/Deny buttons as mailto: links
that pre-fill 'APPROVE [ref:N]' / 'DENY [ref:N]' — the partner taps a
button and hits Send instead of typing a reply. There's no hosted
backend here (same architecture as the Windows app), so a true
zero-tap button isn't possible; this is the closest equivalent. Falls
back to the existing plain-text reply instructions for clients that
don't render HTML.
---
 lib/screens/home_screen.dart           |  8 ++-
 lib/services/email_service.dart        | 62 +++++++++++++++++++++--
 lib/widgets/unlock_duration_sheet.dart | 69 ++++++++++++++++++++++++--
 3 files changed, 128 insertions(+), 11 deletions(-)

diff --git a/lib/screens/home_screen.dart b/lib/screens/home_screen.dart
index b7ee851..662c10d 100644
--- a/lib/screens/home_screen.dart
+++ b/lib/screens/home_screen.dart
@@ -96,9 +96,13 @@ class _HomeScreenState extends State<HomeScreen> with WidgetsBindingObserver {
   }
 
   Future<void> _requestUnlock(ItemStatus s) async {
-    final duration =
-        await UnlockDurationSheet.show(context, s.item.name);
+    final duration = await UnlockDurationSheet.show(context, s.item.name,
+        hasPin: _hasPin);
     if (duration == null) return;
+    if (duration == kUsePinSentinel) {
+      await _unlockWithPin(s);
+      return;
+    }
     final res = await _api.requestUnlock(s.item, duration);
     if (res.ok) {
       _confirm('Unlock request #${res.requestId} sent for "${s.item.name}"');
