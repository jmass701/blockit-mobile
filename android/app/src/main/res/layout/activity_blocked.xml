<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen "Blocked" screen shown by BlockedOverlayActivity when a locked
     app is caught. Teal background matching the brand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D9488"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blocked"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blockedAppLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#CCFBF1"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="This app is locked. Open BlockIT to request an unlock."
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/openBlockItButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Open BlockIT"
        android:textColor="#0F766E"
        android:backgroundTint="#FFFFFF" />

</LinearLayout>
