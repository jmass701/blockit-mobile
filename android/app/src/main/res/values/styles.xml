<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme shown while the Flutter engine warms up. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Applied once Flutter draws its first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Full-screen theme for the "Blocked" activity. -->
    <style name="BlockedTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#0D9488</item>
    </style>
</resources>
